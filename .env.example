# Money Vault API — environment configuration
#
# For LOCAL DEVELOPMENT, copy this file to .env.development and fill in your
# money-vault-dev Supabase project credentials. .env.development is loaded
# first and takes priority over .env, so production credentials are never
# used during local development.
#
#   cp .env.example .env.development
#   # Fill in SUPABASE_DB_URL and JWT_SECRET from your dev Supabase project.
#   python scripts/run_api_local.py
#
# For PRODUCTION (Cloud Run), set these as container environment variables.
# The .env file is only a local fallback.

# FastAPI signs and verifies username+PIN session tokens with this secret.
JWT_SECRET=
JWT_EXPIRY_DAYS=30
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8001
# Leave empty in local/lowers to allow all origins (*). Set explicitly in production.
CORS_ALLOWED_ORIGINS=
SUPABASE_DB_URL=
SUPABASE_URL=
SUPABASE_JWT_SECRET=
